{
  "model": "gateway/YOUR_MODEL_NAME",
  "provider": {
    "gateway": {
      "options": {
        "baseURL": "https://api.openai.com/v1",
        "apiKey": "{env:OPENAI_API_KEY}",
        "headerTimeout": 300000,
        "chunkTimeout": 300000
      },
      "models": {
        "YOUR_MODEL_NAME": {
          "id": "YOUR_MODEL_NAME",
          "limit": { "context": 128000, "output": 4096 },
          "pricing": { "input": 5.0, "output": 15.0 }
        }
      }
    }
  }
}
