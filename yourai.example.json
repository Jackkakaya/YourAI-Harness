{
  "$schema": "./yourai.schema.json",
  "execution": {
    "steps": null,
    "context": {
      "safety_margin": 1024,
      "keep_recent_tokens": 20000,
      "summary_tokens": 2000
    }
  },
  "hooks": {
    "events": {}
  },
  "prompt": {
    "system_prompt": null,
    "soul_file": null,
    "memory_file": null,
    "profile_file": null,
    "append_system_prompt": null,
    "memory_file_max_chars": 12000,
    "profile_file_max_chars": 6000,
    "provider_max_chars": 8000
  },
  "model": "gateway/YOUR_MODEL_NAME",
  "theme": "system",
  "yolo": false,
  "trusted_shell": false,
  "extensions": false,
  "providers": {
    "gateway": {
      "api": "openai-compatible",
      "baseURL": "https://api.openai.com/v1",
      "apiKey": "{env:OPENAI_API_KEY}",
      "headerTimeout": 300000,
      "chunkTimeout": 300000
    }
  },
  "models": {
    "gateway/YOUR_MODEL_NAME": {
      "id": "YOUR_MODEL_NAME",
      "limit": {
        "context": 128000,
        "output": 4096
      },
      "provider": "gateway"
    }
  }
}
